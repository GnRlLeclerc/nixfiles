#!/usr/bin/env nu

# Transform all images in a folder to another format using imagemagick
# Optional resize by giving a percentage.
def main [folder: string, --inplace = true, --format = "jpeg", --resize: string] {
    # Find all image files
    let images = (
      ls $folder
      | where type == file
      | where name =~ '\.(png|jpg|jpeg|webp)$'
    )

    let resize_flag = if $resize != null { ["-resize", $resize ] } else null
    let total = ($images | length)

    # Convert in parallel
    $images |  par-each { |image|
        let new = $image.name | path parse | upsert extension { $format } | path join

        magick $image.name ...$resize_flag $new

        if $inplace {
          rm $image.name
        }
    }

    ignore
}

